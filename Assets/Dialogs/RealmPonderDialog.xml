<CanvasWidget xmlns="runtime-namespace:Game" xmlns:p="runtime-namespace:RealmEX.Presets.Ponder">
  <RectangleWidget FillColor="0,0,0,160" OutlineColor="0,0,0,0" IsHitTestVisible="False" />
  <CanvasWidget Name="Ponder.Frame" HorizontalAlignment="Center" VerticalAlignment="Center">
  <StackPanelWidget Name="Ponder.Content" Direction="Vertical">
    <CanvasWidget Name="Ponder.Header" Size="-1,88">
      <CanvasWidget Name="Ponder.HeadingFrame" HorizontalAlignment="Near" VerticalAlignment="Center">
      <StackPanelWidget Name="Ponder.Heading" Direction="Vertical">
        <LabelWidget Name="Ponder.Brand" Color="140,140,140,140" FontScale="1" />
        <LabelWidget Name="Ponder.Title" Color="255,255,255" FontScale="1" WordWrap="True" Margin="0,4" />
      </StackPanelWidget>
      </CanvasWidget>
      <StackPanelWidget Direction="Horizontal" HorizontalAlignment="Far" VerticalAlignment="Center">
        <p:RealmPonderButtonWidget Name="Ponder.Index" Icon="Index" Margin="2,0" />
        <p:RealmPonderButtonWidget Name="Ponder.Close" Icon="Close" Margin="2,0" />
      </StackPanelWidget>
    </CanvasWidget>
    <p:RealmPonderWidget Name="Ponder.Viewport" />
    <StackPanelWidget Name="Ponder.Footer" Direction="Vertical">
      <LabelWidget Name="Ponder.Step" Color="200,200,200,200" FontScale="1" WordWrap="True" TextAnchor="HorizontalCenter" HorizontalAlignment="Center" />
      <StackPanelWidget Name="Ponder.Controls" Direction="Horizontal" HorizontalAlignment="Center">
        <p:RealmPonderButtonWidget Name="Ponder.PreviousScene" Icon="PreviousScene" Margin="1,0" />
        <p:RealmPonderButtonWidget Name="Ponder.Previous" Icon="PreviousKeyframe" Margin="1,0" />
        <p:RealmPonderButtonWidget Name="Ponder.Play" Icon="Pause" IsActive="True" Margin="1,0" />
        <p:RealmPonderButtonWidget Name="Ponder.Next" Icon="NextKeyframe" Margin="1,0" />
        <p:RealmPonderButtonWidget Name="Ponder.NextScene" Icon="NextScene" Margin="1,0" />
        <p:RealmPonderButtonWidget Name="Ponder.Restart" Icon="Replay" Margin="1,0" />
        <p:RealmPonderButtonWidget Name="Ponder.Inspect" Icon="Inspect" Margin="1,0" />
        <p:RealmPonderButtonWidget Name="Ponder.Reading" Icon="Reading" Margin="1,0" />
        <p:RealmPonderButtonWidget Name="Ponder.ResetView" Icon="ResetView" Margin="1,0" />
      </StackPanelWidget>
      <CanvasWidget Name="Ponder.TimelineFrame" HorizontalAlignment="Center"><p:RealmPonderTimelineWidget Name="Ponder.Timeline" /></CanvasWidget>
      <LabelWidget Name="Ponder.Hint" Color="140,140,140,140" FontScale="1" WordWrap="True" TextAnchor="HorizontalCenter" HorizontalAlignment="Center" Margin="0,8" />
    </StackPanelWidget>
  </StackPanelWidget>
    <CanvasWidget Name="Ponder.Tooltip" IsVisible="False" IsHitTestVisible="False">
      <RectangleWidget FillColor="0,0,0,220" OutlineColor="0,0,0,0" IsHitTestVisible="False" />
      <LabelWidget Name="Ponder.TooltipText" Margin="12,8" FontScale="1" WordWrap="True" IsHitTestVisible="False" />
    </CanvasWidget>
  </CanvasWidget>
</CanvasWidget>
